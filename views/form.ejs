<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof item !=='undefined' && typeof item.id !=='undefined' ? 'Update Data Siswa' : 'Add Data Siswa' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <style>
        .form-container {
            max-width: 500px;
            margin: 40px auto;
        }

        form {
            border-radius: 5px;
            background-color: #eff8ff;
            padding: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        input,
        select {
            width: 100%;
            padding: 12px;
            margin: 8px 0;
            display: inline-block;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        input[type=submit] {
            width: 100%;
            background-color: #04a96d;
            color: white;
            padding: 14px;
            margin: 8px 0;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        input[type=submit]:hover {
            background-color: #038958;
        }

        input[type=button] {
            width: 100%;
            background-color: #390dea;
            color: white;
            padding: 14px;
            margin: 8px 0;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        input[type=button]:hover {
            background-color: #2f0bc0;
        }

        input:focus,
        select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 1px #2563eb;
            outline: none;
        }
    </style>
</head>

<body class="bg-light">

    <div class="container form-container">

        <form
            action="?page=<%= typeof page !== 'undefined' ? page : 1 %><%= typeof querySearch !== 'undefined' && querySearch ? '&search=' + querySearch : '' %>"
            method="POST" class="mb-4">

            <input type="text" name="name" placeholder="Insert your name"
                value="<%= typeof item !== 'undefined' ? item.name || '' : '' %>" required><br>
            <input type="number" name="height" placeholder="Insert your height (cm)"
                value="<%= typeof item !== 'undefined' ? item.height || '' : '' %>"><br>
            <input type="number" name="weight" placeholder="Insert your weight (kg)"
                value="<%= typeof item !== 'undefined' ? item.weight || '' : '' %>" step="0.1"><br>
            <input type="date" id="birthdate" name="birthdate"
                value="<%= typeof item !== 'undefined' ? item.birthdate || '' : '' %>"><br>


            <select name="isMarried">
                <option value="">Have you married?</option>


                <option value="false" <%=typeof item !=='undefined' && (item.isMarried===0 || item.isMarried==='0' ||
                    item.isMarried==='false' || item.isMarried===false) ? 'selected' : '' %>>
                    Not yet
                </option>


                <option value="true" <%=typeof item !=='undefined' && (item.isMarried===1 || item.isMarried==='1' ||
                    item.isMarried==='true' || item.isMarried===true) ? 'selected' : '' %>>
                    Yes
                </option>
            </select>
            <br>

            <input type="submit"
                value="<%= typeof item !== 'undefined' && typeof item.id !== 'undefined' ? 'Update Data' : 'Save Data' %>">
            <br>





            <% if (typeof pages !=='undefined' && pages> 1) { %>
                <nav aria-label="Page navigation" class="d-flex justify-content-center mt-3">
                    <ul class="pagination shadow-sm">


                        <li class="page-item <%= page == 1 ? 'disabled' : '' %>">
                            <a class="page-link"
                                href="/?page=<%= parseInt(page) - 1 %><%= typeof querySearch !== 'undefined' && querySearch ? '&search=' + querySearch : '' %>"
                                aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>


                        <% for (let i=1; i <=pages; i++) { %>
                            <li class="page-item <%= page == i ? 'active' : '' %>">
                                <a class="page-link"
                                    href="/?page=<%= i %><%= typeof querySearch !== 'undefined' && querySearch ? '&search=' + querySearch : '' %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>


                                <li class="page-item <%= page == pages ? 'disabled' : '' %>">
                                    <a class="page-link"
                                        href="/?page=<%= parseInt(page) + 1 %><%= typeof querySearch !== 'undefined' && querySearch ? '&search=' + querySearch : '' %>"
                                        aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>

                    </ul>
                </nav>
                <% } %>
    </div>

</body>

</html>