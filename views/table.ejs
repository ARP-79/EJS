<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SQLite BREAD - Data Siswa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>

<body class="bg-light">

    <div class="container my-5">

        <div class="card shadow-sm p-4">

            <div class="border-bottom pb-3 mb-4">
                <h1 class="h2 text-dark m-0 fw-bold">SQLite BREAD (Browse, Read, Edit, Add, Delete) And Pagination</h1>
            </div>

            <form action="/" method="GET" class="mb-4">
                <div class="row mb-3">
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="search" class="form-label fw-bold text-secondary">Search Name</label>
                        <input type="text" class="form-control" id="search" name="search"
                            placeholder="Search by name..."
                            value="<%= typeof querySearch !== 'undefined' ? querySearch : '' %>">
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <button type="submit" class="btn btn-info px-3 fw-bold text-white me-2">Search</button>
                        <a href="/" class="btn btn-warning px-3 fw-bold text-dark">Reset</a>
                    </div>
                </div>
            </form>

            <div class="table-responsive mb-4">
                <table class="table table-hover table-striped align-middle border">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" style="width: 80px;">No.</th>
                            <th scope="col">Name</th>
                            <th scope="col">Height (cm)</th>
                            <th scope="col">Weight (kg)</th>
                            <th scope="col">Birth Date</th>
                            <th scope="col" class="text-center" style="width: 90px;">Avatar</th>
                            <th scope="col">Is Married</th>
                            <th scope="col" class="text-center" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (rows.length === 0) { %>
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Belum ada data siswa tersedia.</td>
                            </tr>
                        <% } else { %>
                            <% rows.forEach((item, index) => { %>
                                <tr>
                                    <td class="fw-bold">
                                        <%= (typeof currentOffset !== 'undefined' ? currentOffset : 0) + index + 1 %>
                                    </td>
                                    <td>
                                        <%= item.name %>
                                    </td>
                                    <td>
                                        <%= item.height || '-' %>
                                    </td>
                                    <td>
                                        <%= item.weight || '-' %>
                                    </td>
                                    <td>
                                        <%= item.birthdate || '-' %>
                                    </td>
                                    <td class="text-center">                                        
                                        <img src="https://dicebear.com<%= encodeURIComponent(item.name) %>"
                                            alt="Avatar" class="rounded-circle border shadow-sm"
                                            style="width: 40px; height: 40px; object-fit: cover;">
                                    </td>
                                    <td>
                                        <% if (item.isMarried === 1 || item.isMarried === 'true' || item.isMarried === true) { %>
                                            <span class="badge bg-success px-3 py-2 rounded-pill">Yes</span>
                                        <% } else { %>
                                            <span class="badge bg-danger px-3 py-2 rounded-pill">No</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">                           
                                            <a href="/update/<%= item.id %>?page=<%= typeof page !== 'undefined' ? page : 1 %><%= typeof querySearch !== 'undefined' && querySearch ? '&search=' + encodeURIComponent(querySearch) : '' %>"
                                                class="btn btn-sm btn-success px-3">Update</a>
                                            <a href="/delete/<%= item.id %>" class="btn btn-sm btn-danger px-3"
                                                onclick="return confirm('Are you sure you want to delete <%= item.name %>?')">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-column gap-3">
                
                <% if (typeof pages !== 'undefined' && pages > 1) { %>
                    <nav aria-label="Page navigation" class="d-flex justify-content-start">
                        <ul class="pagination mb-0 shadow-sm rounded">
                            <li class="page-item <%= page == 1 ? 'disabled' : '' %>">
                                <a class="page-link"
                                    href="?page=<%= parseInt(page) - 1 %><%= typeof querySearch !== 'undefined' && querySearch ? '&search=' + encodeURIComponent(querySearch) : '' %>">Previous</a>
                            </li>                            
                            <% for (let i = 1; i <= pages; i++) { %>
                                <li class="page-item <%= page == i ? 'active' : '' %>">
                                    <a class="page-link"
                                        href="?page=<%= i %><%= typeof querySearch !== 'undefined' && querySearch ? '&search=' + encodeURIComponent(querySearch) : '' %>">
                                        <%= i %>
                                    </a>
                                </li>
                            <% } %>
                            <li class="page-item <%= page == pages ? 'disabled' : '' %>">
                                <a class="page-link"
                                    href="?page=<%= parseInt(page) + 1 %><%= typeof querySearch !== 'undefined' && querySearch ? '&search=' + encodeURIComponent(querySearch) : '' %>">Next</a>
                            </li>
                        </ul>
                    </nav>
                <% } %> 

                <div class="d-flex justify-content-start">
                    <button type="button" class="btn btn-primary px-4 fw-bold" onclick="window.location.href='/add'">
                        Add
                    </button>
                </div>

            </div>

        </div>
    </div>

    <script src="https://jsdelivr.net"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
</body>

</html>