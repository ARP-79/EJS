-
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SQLite BREAD - Data Siswa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

</head>

<body class="bg-light">
    <div class="container my-5">

        <div class="card shadow-sm p-4">

            <div class="border-bottom pb-3 mb-4">
                <h1 class="h2 text-dark m-0 fw-bold">
                    SQLite BREAD (Browse, Read, Edit, Add, Delete) And Pagination
                </h1>
            </div>

           
            <form action="/" method="GET" class="mb-4">
                <!-- Search Name -->
                <div class="mb-3">
                    <label for="searchName" class="form-label fw-bold text-secondary">
                        Search Name
                    </label>

                    <input type="text" class="form-control" id="searchName" name="name" placeholder="Search name..."
                        value="<%= typeof queryName !== 'undefined' ? queryName : '' %>">
                </div>

                
                <div class="mb-3">
                    <label for="searchHeight" class="form-label fw-bold text-secondary">
                        Height (cm)
                    </label>

                    <input type="number" class="form-control" id="searchHeight" name="height"
                        placeholder="Search height..."
                        value="<%= typeof queryHeight !== 'undefined' ? queryHeight : '' %>">
                </div>

                
                <div class="mb-3">
                    <label for="searchWeight" class="form-label fw-bold text-secondary">
                        Weight (kg)
                    </label>

                    <input type="number" class="form-control" id="searchWeight" name="weight"
                        placeholder="Search weight..."
                        value="<%= typeof queryWeight !== 'undefined' ? queryWeight : '' %>">
                </div>

              
                <div class="mb-3">
                    <label for="searchBirthdate" class="form-label fw-bold text-secondary">
                        Birth Date
                    </label>

                    <input type="date" class="form-control" id="searchBirthdate" name="birthdate"
                        value="<%= typeof queryBirthdate !== 'undefined' ? queryBirthdate : '' %>">
                </div>

               
                <div class="mb-3">
                    <label for="searchMarried" class="form-label fw-bold text-secondary">
                        Is Married
                    </label>

                    <select class="form-select" id="searchMarried" name="isMarried">

                        <option value="" <%=typeof queryIsMarried==='undefined' || queryIsMarried==='' ? 'selected' : ''
                            %>>
                            All
                        </option>

                        <option value="1" <%=typeof queryIsMarried !=='undefined' && queryIsMarried=='1' ? 'selected'
                            : '' %>>
                            Yes
                        </option>

                        <option value="0" <%=typeof queryIsMarried !=='undefined' && queryIsMarried=='0' ? 'selected'
                            : '' %>>
                            Not Yet
                        </option>

                    </select>
                </div>


                
                <div class="row mt-3">
                    <div class="col-12">

                        <button type="submit" class="btn btn-info px-4 fw-bold text-white me-2">
                            Search
                        </button>

                        <a href="/" class="btn btn-warning px-4 fw-bold text-dark">
                            Reset
                        </a>

                    </div>
                </div>

            </form>

           
            <div class="table-responsive mb-4">

                <table class="table table-hover table-striped align-middle border">

                    <thead class="table-dark">
                        <tr>
                            <th scope="col" style="width: 80px;">No.</th>
                            <th scope="col">Name</th>
                            <th scope="col">Height (cm)</th>
                            <th scope="col">Weight (kg)</th>
                            <th scope="col">Birth Date</th>
                            <th scope="col">Is Married</th>
                            <th scope="col" class="text-center" style="width: 200px;">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (rows.length===0) { %>

                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Belum ada data siswa yang sesuai dengan pencarian.
                                </td>
                            </tr>

                            <% } else { %>

                                <% rows.forEach((item, index)=> { %>

                                    <tr>

                                        <td class="fw-bold">
                                            <%= (typeof currentOffset !=='undefined' ? currentOffset : 0) + index + 1 %>
                                        </td>

                                        <td>
                                            <%= item.name %>
                                        </td>

                                        <td>
                                            <%= item.height || '-' %>
                                        </td>

                                        <td>
                                            <%= item.weight || '-' %>
                                        </td>

                                        <td>
                                            <%= item.birthdate || '-' %>
                                        </td>

                                        <td>
                                            <% if ( item.isMarried===1 || item.isMarried==='true' ||
                                                item.isMarried===true ) { %>

                                                <span class="badge bg-success px-3 py-2 rounded-pill">
                                                    Yes
                                                </span>

                                                <% } else { %>

                                                    <span class="badge bg-danger px-3 py-2 rounded-pill">
                                                        Not Yet
                                                    </span>

                                                    <% } %>
                                        </td>

                                        <td>
                                            <div class="d-flex justify-content-center gap-2">

                                                <a href="/update/<%= item.id %>?page=<%= typeof page !== 'undefined' ? page : 1 %><%= typeof queryName !== 'undefined' && queryName ? '&name=' + encodeURIComponent(queryName) : '' %><%= typeof queryHeight !== 'undefined' && queryHeight ? '&height=' + encodeURIComponent(queryHeight) : '' %><%= typeof queryWeight !== 'undefined' && queryWeight ? '&weight=' + encodeURIComponent(queryWeight) : '' %><%= typeof queryBirthdate !== 'undefined' && queryBirthdate ? '&birthdate=' + encodeURIComponent(queryBirthdate) : '' %><%= typeof queryIsMarried !== 'undefined' && queryIsMarried !== '' ? '&isMarried=' + encodeURIComponent(queryIsMarried) : '' %>"
                                                    class="btn btn-sm btn-success px-3">
                                                    Update
                                                </a>

                                                <a href="/delete/<%= item.id %>" class="btn btn-sm btn-danger px-3"
                                                    onclick="return confirm('Are you sure you want to delete <%= item.name %>?')">
                                                    Delete
                                                </a>

                                            </div>
                                        </td>

                                    </tr>

                                    <% }) %>

                                        <% } %>

                    </tbody>

                </table>

            </div>

           
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 mt-3">

                
                <div class="order-2 order-sm-1">

                    <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm"
                        onclick="window.location.href='/add'">
                        Add
                    </button>

                </div>

                
                <div class="order-1 order-sm-2">

                    <% if (typeof pages !=='undefined' && pages> 1) { %>

                        <nav aria-label="Page navigation">

                            <ul class="pagination mb-0 shadow-sm rounded">

                                
                                <li class="page-item <%= page == 1 ? 'disabled' : '' %>">

                                    <a class="page-link"
                                        href="?page=<%= parseInt(page) - 1 %><%= typeof queryName !== 'undefined' && queryName ? '&name=' + encodeURIComponent(queryName) : '' %><%= typeof queryHeight !== 'undefined' && queryHeight ? '&height=' + encodeURIComponent(queryHeight) : '' %><%= typeof queryWeight !== 'undefined' && queryWeight ? '&weight=' + encodeURIComponent(queryWeight) : '' %><%= typeof queryBirthdate !== 'undefined' && queryBirthdate ? '&birthdate=' + encodeURIComponent(queryBirthdate) : '' %><%= typeof queryIsMarried !== 'undefined' && queryIsMarried !== '' ? '&isMarried=' + encodeURIComponent(queryIsMarried) : '' %>">
                                        Previous
                                    </a>

                                </li>

                                
                                <% for (let i=1; i <=pages; i++) { %>

                                    <li class="page-item <%= page == i ? 'active' : '' %>">

                                        <a class="page-link"
                                            href="?page=<%= i %><%= typeof queryName !== 'undefined' && queryName ? '&name=' + encodeURIComponent(queryName) : '' %><%= typeof queryHeight !== 'undefined' && queryHeight ? '&height=' + encodeURIComponent(queryHeight) : '' %><%= typeof queryWeight !== 'undefined' && queryWeight ? '&weight=' + encodeURIComponent(queryWeight) : '' %><%= typeof queryBirthdate !== 'undefined' && queryBirthdate ? '&birthdate=' + encodeURIComponent(queryBirthdate) : '' %><%= typeof queryIsMarried !== 'undefined' && queryIsMarried !== '' ? '&isMarried=' + encodeURIComponent(queryIsMarried) : '' %>">
                                            <%= i %>
                                        </a>

                                    </li>

                                    <% } %>

                                       
                                        <li class="page-item <%= page == pages ? 'disabled' : '' %>">

                                            <a class="page-link"
                                                href="?page=<%= parseInt(page) + 1 %><%= typeof queryName !== 'undefined' && queryName ? '&name=' + encodeURIComponent(queryName) : '' %><%= typeof queryHeight !== 'undefined' && queryHeight ? '&height=' + encodeURIComponent(queryHeight) : '' %><%= typeof queryWeight !== 'undefined' && queryWeight ? '&weight=' + encodeURIComponent(queryWeight) : '' %><%= typeof queryBirthdate !== 'undefined' && queryBirthdate ? '&birthdate=' + encodeURIComponent(queryBirthdate) : '' %><%= typeof queryIsMarried !== 'undefined' && queryIsMarried !== '' ? '&isMarried=' + encodeURIComponent(queryIsMarried) : '' %>">
                                                Next
                                            </a>

                                        </li>

                            </ul>

                        </nav>

                        <% } %>

                </div>

            </div>

        </div>

    </div>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>

</body>

</html>